    "walkthroughs": [
      {
        "id": "orqiva.getStarted",
        "title": "Get started with Orqiva",
        "description": "Six steps from an empty folder to Claude Code working through one-day sprints.",
        "steps": [
          {
            "id": "setup",
            "title": "Set up this computer",
            "description": "Node.js, Claude Code and git.\n[Check environment](command:orqiva.checkEnvironment)\n[Open setup](command:orqiva.openSetup)",
            "media": {
              "markdown": "media/walkthrough/setup.md"
            },
            "completionEvents": [
              "onContext:orqiva.engineFound"
            ]
          },
          {
            "id": "connect",
            "title": "Sign in to Orqiva",
            "description": "Your server's address, your e-mail and your password; this computer keeps a personal token.\n[Sign in](command:orqiva.signIn)",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onContext:orqiva.connected"
            ]
          },
          {
            "id": "link",
            "title": "Link or create a project",
            "description": "One folder, one Orqiva project; the link is committed with the repository.\n[New project](command:orqiva.newProject)\n[Link project](command:orqiva.linkProject)",
            "media": {
              "markdown": "media/walkthrough/link.md"
            },
            "completionEvents": [
              "onContext:orqiva.linked"
            ]
          },
          {
            "id": "plan",
            "title": "Plan the project",
            "description": "Describe it; Claude drafts architecture, rules, design and one-day sprints; you publish.\n[Plan the project](command:orqiva.openPlanPanel)",
            "media": {
              "markdown": "media/walkthrough/plan.md"
            },
            "completionEvents": [
              "onContext:orqiva.planned"
            ]
          },
          {
            "id": "develop",
            "title": "Develop",
            "description": "Open Claude Code in the project; it takes the next task and fingerprints what it writes.\n[Start development](command:orqiva.startDevelopment)",
            "media": {
              "markdown": "media/walkthrough/develop.md"
            },
            "completionEvents": [
              "onContext:orqiva.developing"
            ]
          },
          {
            "id": "release",
            "title": "Release",
            "description": "Bump the version from the items done, build the image, deploy it and post it back to the board.\n[Version](command:orqiva.openVersionPanel)\n[Docker](command:orqiva.openDockerPanel)\n[Deploy](command:orqiva.openDeployPanel)",
            "media": {
              "markdown": "media/walkthrough/release.md"
            },
            "completionEvents": [
              "onContext:orqiva.released"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "npm run build && node ./dist/test/runTests.js",
    "package": "vsce package --no-dependencies",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.4",
    "@types/vscode": "1.90.0",
    "@vitest/coverage-v8": "5.0.1",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "glob": "13.0.6",
    "mocha": "12.0.2",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode Orqiva only shows the board from the last sync and the status bar. Trust the folder to run the loop commands and Claude Code in it."
    }
  },
  "dependencies": {
    "@vscode/codicons": "0.0.46-24"
  }
